generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// المستخدمون والمصادقة
// ============================================

model User {
  id                   String    @id @default(cuid())
  name                 String
  email                String    @unique
  phone                String?   @unique
  password             String?
  nationalId           String?   @unique
  avatar               String?
  role                 Role      @default(MEMBER)
  isActive             Boolean   @default(true)
  authVersion          Int       @default(1)
  activeOrganizationId String?
  lastLoginAt          DateTime?
  emailVerified        DateTime?
  phoneVerified        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  member                  Member?
  volunteer               Volunteer?
  beneficiary             Beneficiary?
  donor                   Donor?
  assignedTasks           Task[]                     @relation("TaskAssignee")
  taskComments            TaskComment[]
  createdTasks            Task[]                     @relation("TaskCreator")
  evaluations             Evaluation[]               @relation("Evaluator")
  receivedEvals           Evaluation[]               @relation("EvaluatedEmployee")
  auditLogs               AuditLog[]
  notifications           Notification[]
  permissions             UserPermission[]
  createdNews             News[]                     @relation("NewsAuthor")
  createdProjects         Project[]                  @relation("ProjectCreator")
  boardMemberships        BoardMember[]
  organizationMemberships OrganizationMembership[]
  activeOrganization      Organization?              @relation("ActiveOrganization", fields: [activeOrganizationId], references: [id], onDelete: SetNull)
  supportAccessRequests   PlatformSupportAccess[]    @relation("SupportRequester")
  supportAccessApprovals  PlatformSupportAccess[]    @relation("SupportApprover")
  connectedChannels       ConnectedChannel[]         @relation("ChannelCreator")
  communicationContent    CommunicationContentItem[] @relation("CommunicationContentCreator")
  communicationCampaigns  CommunicationCampaign[]    @relation("CommunicationCampaignOwner")
  communicationReviews    CommunicationReview[]      @relation("ReviewAuthor")
  approvedPublications    PublicationPlan[]          @relation("PublicationApprover")
  aiProposals             AIProposal[]               @relation("AIProposalAuthor")
  tenantAccessLeases      TenantAccessLease[]
  tenantBrokerAuditEvents TenantBrokerAuditEvent[]

  @@map("users")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  EDITOR
  MEMBER
  DONOR
  VOLUNTEER
  BENEFICIARY
  EMPLOYEE
}

// ============================================
// إدارة الصلاحيات
// ============================================

model Permission {
  id          String  @id @default(cuid())
  name        String  @unique
  description String?
  module      String
  action      String

  users                         UserPermission[]
  organizationRolePermissions   OrganizationRolePermission[]
  membershipPermissionOverrides MembershipPermissionOverride[]

  @@map("permissions")
}

// W02 internal contracts use references, hashes and redacted metadata only.
enum SecretRecordStatus {
  ACTIVE
  ROTATED
  REVOKED
}

enum DataClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
  RESTRICTED
}

enum PrivacyRequestType {
  ACCESS
  EXPORT
  DELETE
  CORRECT
}

enum PrivacyRequestStatus {
  REQUESTED
  POLICY_REQUIRED
  APPROVED
  REJECTED
  LEGAL_HOLD
  COMPLETED
}

enum ActivationStatus {
  PENDING
  ACTIVATED
  REVOKED
  EXPIRED
}

enum IdentityProviderEnvironment {
  SANDBOX
  PRODUCTION
}

enum IdentityProviderStatus {
  ACTIVE
  DISABLED
  REVOKED
}

model UserPermission {
  userId       String
  permissionId String

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([userId, permissionId])
  @@map("user_permissions")
}

// ============================================
// إدارة الجمعية
// ============================================

model Organization {
  id             String    @id @default(cuid())
  name           String
  nameEn         String?
  description    String?
  logo           String?
  phone          String?
  email          String?
  website        String?
  address        String?
  city           String?
  postalCode     String?
  registrationNo String?   @unique
  ncnpRef        String?   @unique
  taxNumber      String?
  foundedDate    DateTime?
  primaryColor   String    @default("#0D9488")
  secondaryColor String    @default("#115E59")
  accentColor    String    @default("#F59E0B")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  boardMembers            BoardMember[]
  assemblyMeetings        AssemblyMeeting[]
  financialAccounts       FinancialAccount[]
  settings                SiteSetting[]
  memberships             OrganizationMembership[]
  activeUsers             User[]                          @relation("ActiveOrganization")
  roles                   OrganizationRole[]
  supportAccessRequests   PlatformSupportAccess[]
  connectedChannels       ConnectedChannel[]
  brandVoiceKit           BrandVoiceKit?
  communicationCampaigns  CommunicationCampaign[]
  communicationContent    CommunicationContentItem[]
  publicationPlans        PublicationPlan[]
  webhookEvents           WebhookEvent[]
  metricSnapshots         MetricSnapshot[]
  auditLogs               AuditLog[]
  beneficiaries           Beneficiary[]
  donors                  Donor[]
  donations               Donation[]
  donationCampaigns       DonationCampaign[]
  projects                Project[]
  newsItems               News[]
  events                  Event[]
  tasks                   Task[]
  surveys                 Survey[]
  documents               Document[]
  privateArtifacts        PrivateArtifact[]
  budgets                 Budget[]
  budgetItems             BudgetItem[]
  expenses                Expense[]
  memberRecords           Member[]                        @relation("MemberOrganization")
  kpis                    KPI[]
  kpiRecords              KPIRecord[]
  databasePrincipals      TenantDatabasePrincipal[]
  tenantAccessLeases      TenantAccessLease[]
  tenantBrokerAuditEvents TenantBrokerAuditEvent[]
  secretRecords           SecretRecord[]
  secretAccessAudits      SecretAccessAudit[]
  privacyRequests         PrivacyRequest[]
  privacyPolicyBindings   PrivacyPolicyBinding[]
  activationRecords       ActivationRecord[]
  identityProviderConfigs IdentityProviderConfig[]
  identitySubjectBindings IdentitySubjectBinding[]
  identityCallbackStates  IdentityProviderCallbackState[]
  subscriptions           OrganizationSubscription[]
  entitlements            OrganizationEntitlement[]
  paymentConfigurations   PaymentConfiguration[]
  paymentTransactions     PaymentTransaction[]
  platformInvoices        PlatformInvoice[]
  paymentWebhookEvents    PaymentWebhookEvent[]

  @@map("organizations")
}

// ============================================
// سياق الجمعيات والاتصال الرقمي
// ============================================

model OrganizationMembership {
  id             String    @id @default(cuid())
  organizationId String
  userId         String
  role           Role      @default(MEMBER)
  isDefault      Boolean   @default(false)
  isActive       Boolean   @default(true)
  policyVersion  Int       @default(1)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization            Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationRoles       MembershipRole[]
  permissionOverrides     MembershipPermissionOverride[]
  tenantAccessLeases      TenantAccessLease[]
  tenantBrokerAuditEvents TenantBrokerAuditEvent[]

  @@unique([organizationId, userId])
  @@index([userId, isActive])
  @@index([organizationId, isActive])
  @@index([organizationId, userId, policyVersion])
  @@map("organization_memberships")
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum PlatformSupportAccessStatus {
  REQUESTED
  APPROVED
  REVOKED
  EXPIRED
}

model OrganizationRole {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  OrganizationRolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, name])
  @@index([organizationId, isSystem])
  @@map("organization_roles")
}

model OrganizationRolePermission {
  organizationRoleId String
  permissionId       String
  effect             PermissionEffect @default(ALLOW)

  organizationRole OrganizationRole @relation(fields: [organizationRoleId], references: [id], onDelete: Cascade)
  permission       Permission       @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([organizationRoleId, permissionId])
  @@map("organization_role_permissions")
}

model MembershipRole {
  membershipId       String
  organizationRoleId String
  assignedAt         DateTime @default(now())

  membership       OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  organizationRole OrganizationRole       @relation(fields: [organizationRoleId], references: [id], onDelete: Cascade)

  @@id([membershipId, organizationRoleId])
  @@map("membership_roles")
}

model MembershipPermissionOverride {
  membershipId String
  permissionId String
  effect       PermissionEffect
  reason       String
  expiresAt    DateTime?
  createdAt    DateTime         @default(now())

  membership OrganizationMembership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  permission Permission             @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([membershipId, permissionId])
  @@index([membershipId, expiresAt])
  @@map("membership_permission_overrides")
}

model PlatformSupportAccess {
  id             String                      @id @default(cuid())
  organizationId String
  requesterId    String
  approverId     String?
  status         PlatformSupportAccessStatus @default(REQUESTED)
  reason         String
  purposeCode    String
  readOnly       Boolean                     @default(true)
  expiresAt      DateTime
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  revokedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requester    User         @relation("SupportRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  approver     User?        @relation("SupportApprover", fields: [approverId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([requesterId, status])
  @@map("platform_support_access")
}

// ============================================
// W02 — Tenant Access Broker lifecycle metadata
// Credential material remains external to Prisma, database records, Git and logs.
// ============================================

enum TenantDatabasePrincipalStatus {
  ACTIVE
  REVOKED
}

enum TenantAccessLeaseStatus {
  ACTIVE
  CONSUMED
  REVOKED
  EXPIRED
}

model TenantDatabasePrincipal {
  id                       String                        @id @default(cuid())
  organizationId           String
  principalName            String                        @unique
  credentialReference      String                        @unique
  queueCredentialReference String?                       @unique
  generation               Int                           @default(1)
  status                   TenantDatabasePrincipalStatus @default(ACTIVE)
  activatedAt              DateTime                      @default(now())
  revokedAt                DateTime?
  createdAt                DateTime                      @default(now())
  updatedAt                DateTime                      @updatedAt

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leases       TenantAccessLease[]

  @@index([organizationId, status])
  @@index([organizationId, generation])
  @@map("tenant_database_principals")
}

model TenantAccessLease {
  id                        String                  @id @default(cuid())
  organizationId            String
  membershipId              String
  userId                    String
  tenantDatabasePrincipalId String
  correlationId             String
  connectionId              String                  @unique
  contextFingerprint        String
  status                    TenantAccessLeaseStatus @default(ACTIVE)
  issuedAt                  DateTime                @default(now())
  expiresAt                 DateTime
  consumedAt                DateTime?
  revokedAt                 DateTime?
  createdAt                 DateTime                @default(now())
  updatedAt                 DateTime                @updatedAt

  organization      Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership        OrganizationMembership  @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  user              User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  databasePrincipal TenantDatabasePrincipal @relation(fields: [tenantDatabasePrincipalId], references: [id], onDelete: Restrict)

  @@index([organizationId, status, expiresAt])
  @@index([membershipId, status])
  @@index([userId, status])
  @@index([correlationId])
  @@map("tenant_access_leases")
}

model TenantBrokerAuditEvent {
  id                        String   @id @default(cuid())
  organizationId            String?
  membershipId              String?
  userId                    String?
  tenantDatabasePrincipalId String?
  leaseId                   String?
  correlationId             String
  decision                  String
  reasonCode                String
  source                    String
  createdAt                 DateTime @default(now())

  organization Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  membership   OrganizationMembership? @relation(fields: [membershipId], references: [id], onDelete: SetNull)
  user         User?                   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([correlationId])
  @@index([leaseId])
  @@map("tenant_broker_audit_events")
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
  TIKTOK
  YOUTUBE
  X
}

enum ConnectedChannelStatus {
  CONFIGURATION_REQUIRED
  READY
  NEEDS_REAUTH
  RESTRICTED
  DISCONNECTED
  ERROR
}

enum CommunicationContentType {
  NEWS
  EVENT
  PROJECT
  DONATION_CAMPAIGN
  ACHIEVEMENT
  SUCCESS_STORY
  INDEPENDENT
}

enum CommunicationWorkflowStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
  CANCELLED
  ARCHIVED
}

enum PublicationErrorClass {
  TOKEN_EXPIRED
  PERMISSION_DENIED
  RATE_LIMIT
  INVALID_MEDIA
  UNSUPPORTED_FORMAT
  PROVIDER_TIMEOUT
  PROVIDER_OUTAGE
  ACCESS_REVOKED
  ACCOUNT_REMOVED
  APP_REVIEW_RESTRICTION
  CONFIGURATION_REQUIRED
  UNKNOWN
}

enum MetricKind {
  VIEWS
  REACH
  ENGAGEMENT
  LIKES
  COMMENTS
  SHARES
  CLICKS
  FOLLOWERS
  VIDEO_VIEWS
}

enum AIProposalType {
  DRAFT
  REWRITE
  CHANNEL_ADAPTATION
  TITLE
  CTA
  HASHTAGS
  CAMPAIGN
  SCHEDULE
}

model ConnectedChannel {
  id             String                 @id @default(cuid())
  organizationId String
  platform       SocialPlatform
  externalId     String
  displayName    String
  accountType    String?
  status         ConnectedChannelStatus @default(CONFIGURATION_REQUIRED)
  scopes         String[]               @default([])
  capabilities   Json
  lastSyncedAt   DateTime?
  reauthReason   String?
  metadata       Json?
  createdById    String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?              @relation("ChannelCreator", fields: [createdById], references: [id], onDelete: SetNull)
  credential   ChannelCredential?
  variants     ChannelVariant[]
  metrics      MetricSnapshot[]

  @@unique([organizationId, platform, externalId])
  @@index([organizationId, platform, status])
  @@map("connected_channels")
}

model ChannelCredential {
  id                    String    @id @default(cuid())
  connectedChannelId    String    @unique
  encryptedAccessToken  String    @db.Text
  encryptedRefreshToken String?   @db.Text
  encryptionVersion     Int       @default(1)
  expiresAt             DateTime?
  refreshExpiresAt      DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  connectedChannel ConnectedChannel @relation(fields: [connectedChannelId], references: [id], onDelete: Cascade)

  @@map("channel_credentials")
}

model BrandVoiceKit {
  id                 String   @id @default(cuid())
  organizationId     String   @unique
  tone               String?
  preferredTerms     String[] @default([])
  forbiddenTerms     String[] @default([])
  officialHashtags   String[] @default([])
  contactInformation String?
  defaultCta         String?
  identityNotes      String?  @db.Text
  templates          Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("brand_voice_kits")
}

model CommunicationCampaign {
  id                String    @id @default(cuid())
  organizationId    String
  title             String
  objective         String?
  relatedEntityType String?
  relatedEntityId   String?
  startDate         DateTime?
  endDate           DateTime?
  ownerId           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?                      @relation("CommunicationCampaignOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  contentItems CommunicationContentItem[]

  @@index([organizationId, startDate])
  @@map("communication_campaigns")
}

model CommunicationContentItem {
  id             String                      @id @default(cuid())
  organizationId String
  campaignId     String?
  sourceType     String?
  sourceId       String?
  type           CommunicationContentType
  title          String
  body           String                      @db.Text
  status         CommunicationWorkflowStatus @default(DRAFT)
  tags           String[]                    @default([])
  assetUrls      String[]                    @default([])
  createdById    String?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  campaign     CommunicationCampaign? @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  createdBy    User?                  @relation("CommunicationContentCreator", fields: [createdById], references: [id], onDelete: SetNull)
  variants     ChannelVariant[]
  aiProposals  AIProposal[]

  @@index([organizationId, status, createdAt])
  @@index([organizationId, sourceType, sourceId])
  @@map("communication_content_items")
}

model ChannelVariant {
  id                 String                      @id @default(cuid())
  contentItemId      String
  connectedChannelId String
  platform           SocialPlatform
  title              String?
  copy               String                      @db.Text
  payload            Json?
  assetUrls          String[]                    @default([])
  status             CommunicationWorkflowStatus @default(DRAFT)
  version            Int                         @default(1)
  validation         Json?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt

  contentItem      CommunicationContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  connectedChannel ConnectedChannel         @relation(fields: [connectedChannelId], references: [id], onDelete: Cascade)
  reviews          CommunicationReview[]
  publicationPlans PublicationPlan[]

  @@unique([contentItemId, connectedChannelId])
  @@index([connectedChannelId, status])
  @@map("channel_variants")
}

model CommunicationReview {
  id               String                      @id @default(cuid())
  channelVariantId String
  reviewerId       String
  decision         CommunicationWorkflowStatus
  comment          String?                     @db.Text
  createdAt        DateTime                    @default(now())

  channelVariant ChannelVariant @relation(fields: [channelVariantId], references: [id], onDelete: Cascade)
  reviewer       User           @relation("ReviewAuthor", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@index([channelVariantId, createdAt])
  @@map("communication_reviews")
}

model PublicationPlan {
  id               String                      @id @default(cuid())
  organizationId   String
  channelVariantId String
  scheduledAt      DateTime?
  timezone         String                      @default("Asia/Riyadh")
  status           CommunicationWorkflowStatus @default(APPROVED)
  approvedById     String?
  cancelledAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channelVariant ChannelVariant       @relation(fields: [channelVariantId], references: [id], onDelete: Cascade)
  approvedBy     User?                @relation("PublicationApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  attempts       PublicationAttempt[]

  @@index([organizationId, status, scheduledAt])
  @@index([channelVariantId, scheduledAt])
  @@map("publication_plans")
}

model PublicationAttempt {
  id                    String                      @id @default(cuid())
  publicationPlanId     String
  attemptNumber         Int
  idempotencyKey        String                      @unique
  providerPublicationId String?
  providerUrl           String?
  status                CommunicationWorkflowStatus
  errorClass            PublicationErrorClass?
  errorCode             String?
  userMessage           String?
  technicalMessage      String?                     @db.Text
  providerTraceId       String?
  startedAt             DateTime                    @default(now())
  completedAt           DateTime?

  publicationPlan PublicationPlan @relation(fields: [publicationPlanId], references: [id], onDelete: Cascade)

  @@unique([publicationPlanId, attemptNumber])
  @@index([publicationPlanId, status])
  @@map("publication_attempts")
}

model WebhookEvent {
  id                         String         @id @default(cuid())
  organizationId             String
  platform                   SocialPlatform
  externalEventId            String
  connectedChannelExternalId String?
  signatureValid             Boolean        @default(false)
  payload                    Json
  receivedAt                 DateTime       @default(now())
  processedAt                DateTime?
  processingError            String?        @db.Text

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, platform, externalEventId])
  @@index([platform, receivedAt])
  @@map("webhook_events")
}

model MetricSnapshot {
  id                 String     @id @default(cuid())
  organizationId     String
  connectedChannelId String
  channelVariantId   String?
  metric             MetricKind
  value              Float
  providerPeriodFrom DateTime?
  providerPeriodTo   DateTime?
  collectedAt        DateTime   @default(now())
  raw                Json?

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedChannel ConnectedChannel @relation(fields: [connectedChannelId], references: [id], onDelete: Cascade)

  @@index([organizationId, metric, collectedAt])
  @@index([connectedChannelId, collectedAt])
  @@map("metric_snapshots")
}

model AIProposal {
  id            String         @id @default(cuid())
  contentItemId String
  requestedById String
  type          AIProposalType
  input         Json?
  output        Json
  status        String         @default("DRAFT")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  contentItem CommunicationContentItem @relation(fields: [contentItemId], references: [id], onDelete: Cascade)
  requestedBy User                     @relation("AIProposalAuthor", fields: [requestedById], references: [id], onDelete: Cascade)

  @@index([contentItemId, type, createdAt])
  @@map("ai_proposals")
}

model OAuthState {
  id              String         @id @default(cuid())
  organizationId  String
  userId          String
  platform        SocialPlatform
  state           String         @unique
  codeVerifier    String?
  redirectUri     String
  requestedScopes String[]       @default([])
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime       @default(now())

  @@index([organizationId, platform, expiresAt])
  @@index([userId, expiresAt])
  @@map("oauth_states")
}

model BoardMember {
  id             String    @id @default(cuid())
  organizationId String
  userId         String?
  name           String
  position       String
  startDate      DateTime
  endDate        DateTime?
  isActive       Boolean   @default(true)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("board_members")
}

model AssemblyMeeting {
  id             String        @id @default(cuid())
  organizationId String
  title          String
  description    String?
  meetingDate    DateTime
  meetingTime    String?
  location       String?
  status         MeetingStatus @default(SCHEDULED)
  agenda         Json?
  minutes        String?
  decisions      Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("assembly_meetings")
}

enum MeetingStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ============================================
// إدارة الأعضاء
// ============================================

model Member {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String           @unique
  membershipType MembershipType   @default(REGULAR)
  status         MembershipStatus @default(ACTIVE)
  startDate      DateTime         @default(now())
  endDate        DateTime?
  membershipFee  Float            @default(0)
  paidAmount     Float            @default(0)
  paymentStatus  PaymentStatus    @default(PENDING)

  organization Organization?       @relation("MemberOrganization", fields: [organizationId], references: [id], onDelete: SetNull)
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments     MembershipPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("members")
}

enum MembershipType {
  FOUNDER
  REGULAR
  HONORARY
  ASSOCIATE
}

enum MembershipStatus {
  ACTIVE
  INACTIVE
  EXPIRED
  SUSPENDED
  PENDING_RENEWAL
}

enum PaymentStatus {
  PAID
  PENDING
  PARTIAL
  OVERDUE
}

model MembershipPayment {
  id             String        @id @default(cuid())
  memberId       String
  amount         Float
  paymentMethod  String?
  transactionRef String?
  receiptNo      String?
  paidAt         DateTime?
  status         PaymentStatus @default(PENDING)

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("membership_payments")
}

// ============================================
// إدارة المتطوعين
// ============================================

model Volunteer {
  id           String          @id @default(cuid())
  userId       String          @unique
  skills       String[]
  availability String          @default("flexible")
  totalHours   Float           @default(0)
  status       VolunteerStatus @default(ACTIVE)

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  activities VolunteerActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("volunteers")
}

enum VolunteerStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model VolunteerActivity {
  id           String   @id @default(cuid())
  volunteerId  String
  eventId      String?
  projectId    String?
  description  String
  hours        Float
  activityDate DateTime

  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("volunteer_activities")
}

// ============================================
// قاعدة بيانات المستفيدين
// ============================================

model Beneficiary {
  id             String            @id @default(cuid())
  organizationId String?
  userId         String?           @unique
  name           String
  nationalId     String?
  phone          String
  email          String?
  address        String?
  city           String?
  gender         Gender            @default(MALE)
  dateOfBirth    DateTime?
  familyMembers  Int?
  incomeLevel    String?
  needCategory   String?
  status         BeneficiaryStatus @default(ACTIVE)
  notes          String?

  user         User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  documents    BeneficiaryDocument[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([nationalId])
  @@index([status])
  @@index([organizationId])
  @@map("beneficiaries")
}

enum Gender {
  MALE
  FEMALE
}

enum BeneficiaryStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  COMPLETED
}

model BeneficiaryDocument {
  id            String   @id @default(cuid())
  beneficiaryId String
  name          String
  fileType      String
  fileUrl       String
  uploadedAt    DateTime @default(now())

  beneficiary Beneficiary @relation(fields: [beneficiaryId], references: [id], onDelete: Cascade)

  @@map("beneficiary_documents")
}

// ============================================
// إدارة المانحين
// ============================================

model Donor {
  id             String      @id @default(cuid())
  organizationId String?
  userId         String?     @unique
  name           String
  phone          String?
  email          String?
  address        String?
  donorType      DonorType   @default(INDIVIDUAL)
  totalDonations Float       @default(0)
  lastDonationAt DateTime?
  notes          String?
  status         DonorStatus @default(ACTIVE)

  user               User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization       Organization?        @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  communications     DonorCommunication[]
  donations          Donation[]
  recurringDonations RecurringDonation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("donors")
}

enum DonorType {
  INDIVIDUAL
  CORPORATE
  GOVERNMENT
}

enum DonorStatus {
  ACTIVE
  INACTIVE
  POTENTIAL
}

model DonorCommunication {
  id          String   @id @default(cuid())
  donorId     String
  type        String
  subject     String?
  notes       String
  contactDate DateTime @default(now())

  donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("donor_communications")
}

// ============================================
// التبرعات والفواتير الإلكترونية
// ============================================

model Donation {
  id             String         @id @default(cuid())
  organizationId String?
  donorId        String?
  campaignId     String?
  projectId      String?
  amount         Float
  currency       String         @default("SAR")
  paymentMethod  String?
  paymentRef     String?
  status         DonationStatus @default(PENDING)
  isAnonymous    Boolean        @default(false)
  isGuest        Boolean        @default(false)
  guestName      String?
  guestPhone     String?
  guestEmail     String?

  donor              Donor?              @relation(fields: [donorId], references: [id], onDelete: SetNull)
  organization       Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  campaign           DonationCampaign?   @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  project            Project?            @relation(fields: [projectId], references: [id])
  invoice            Invoice?
  paymentTransaction PaymentTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([donorId])
  @@index([campaignId])
  @@index([projectId])
  @@index([status])
  @@index([organizationId])
  @@map("donations")
}

enum DonationStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model DonationCampaign {
  id              String         @id @default(cuid())
  organizationId  String?
  title           String
  description     String?
  imageUrl        String?
  targetAmount    Float
  collectedAmount Float          @default(0)
  startDate       DateTime
  endDate         DateTime?
  status          CampaignStatus @default(ACTIVE)
  displayOrder    Int            @default(0)

  donations    Donation[]
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("donation_campaigns")
}

enum CampaignStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

model RecurringDonation {
  id            String    @id @default(cuid())
  donorId       String
  amount        Float
  frequency     String
  paymentMethod String
  startDate     DateTime
  endDate       DateTime?
  isActive      Boolean   @default(true)
  lastChargedAt DateTime?

  donor Donor @relation(fields: [donorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("recurring_donations")
}

model Invoice {
  id          String        @id @default(cuid())
  invoiceNo   String        @unique
  donationId  String?       @unique
  memberId    String?
  orderId     String?       @unique
  amount      Float
  taxAmount   Float         @default(0)
  totalAmount Float
  taxNumber   String
  buyerName   String?
  buyerPhone  String?
  buyerEmail  String?
  status      InvoiceStatus @default(ISSUED)
  issuedAt    DateTime      @default(now())
  pdfUrl      String?

  donation Donation? @relation(fields: [donationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("invoices")
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PAID
  CANCELLED
  REFUNDED
}

// ============================================
// SaaS plans, entitlements and payment ledger
// ============================================

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  EXPIRED
  CANCELLED
}

enum EntitlementStatus {
  ACTIVE
  SUSPENDED
  EXPIRED
}

enum PaymentPurpose {
  PLATFORM_BILLING
  ORGANIZATION_DONATION
}

enum PaymentTransactionStatus {
  CREATED
  PENDING
  AUTHORIZED
  CAPTURED
  FAILED
  REFUNDED
  VOIDED
}

enum PaymentAttemptStatus {
  CREATED
  REDIRECTED
  AUTHORIZED
  CAPTURED
  FAILED
  VOIDED
}

enum PaymentWebhookStatus {
  RECEIVED
  VERIFIED
  REJECTED
  APPLIED
}

enum PaymentAdjustmentType {
  REFUND
  VOID
}

model PlatformPlan {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  currency    String   @default("SAR")
  interval    String
  isActive    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subscriptions OrganizationSubscription[]

  @@map("platform_plans")
}

model OrganizationSubscription {
  id             String             @id @default(cuid())
  organizationId String
  planId         String
  status         SubscriptionStatus @default(TRIAL)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  activatedAt    DateTime?
  suspendedAt    DateTime?
  expiredAt      DateTime?
  source         String
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  plan         PlatformPlan              @relation(fields: [planId], references: [id], onDelete: Restrict)
  entitlements OrganizationEntitlement[]
  transactions PaymentTransaction[]
  invoices     PlatformInvoice[]

  @@index([organizationId, status])
  @@index([planId, status])
  @@map("organization_subscriptions")
}

model OrganizationEntitlement {
  id             String            @id @default(cuid())
  organizationId String
  subscriptionId String
  key            String
  value          Json?
  status         EntitlementStatus @default(ACTIVE)
  startsAt       DateTime          @default(now())
  endsAt         DateTime?
  source         String
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([subscriptionId, status])
  @@map("organization_entitlements")
}

model PaymentConfiguration {
  id              String   @id @default(cuid())
  organizationId  String
  providerKey     String
  credentialRef   String
  enabled         Boolean  @default(false)
  methods         String[]
  callbackBaseUrl String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions PaymentTransaction[]

  @@unique([organizationId, providerKey])
  @@map("payment_configurations")
}

model PaymentTransaction {
  id                     String                   @id @default(cuid())
  organizationId         String
  purpose                PaymentPurpose
  paymentConfigurationId String?
  subscriptionId         String?
  donationId             String?                  @unique
  platformInvoiceId      String?                  @unique
  idempotencyKey         String
  amount                 Decimal                  @db.Decimal(12, 2)
  currency               String                   @default("SAR")
  method                 String
  providerPaymentId      String?
  status                 PaymentTransactionStatus @default(CREATED)
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  capturedAt             DateTime?

  organization    Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  configuration   PaymentConfiguration?     @relation(fields: [paymentConfigurationId], references: [id], onDelete: SetNull)
  subscription    OrganizationSubscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  donation        Donation?                 @relation(fields: [donationId], references: [id], onDelete: SetNull)
  platformInvoice PlatformInvoice?          @relation(fields: [platformInvoiceId], references: [id], onDelete: SetNull)
  attempts        PaymentAttempt[]
  webhookEvents   PaymentWebhookEvent[]
  reconciliations PaymentReconciliation[]
  adjustments     PaymentAdjustment[]

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, purpose, status])
  @@index([providerPaymentId])
  @@map("payment_transactions")
}

model PaymentAttempt {
  id            String               @id @default(cuid())
  transactionId String
  attemptNo     Int
  providerRef   String?
  status        PaymentAttemptStatus @default(CREATED)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@unique([transactionId, attemptNo])
  @@map("payment_attempts")
}

model PaymentWebhookEvent {
  id              String               @id @default(cuid())
  organizationId  String
  transactionId   String?
  providerKey     String
  providerEventId String
  payloadDigest   String
  status          PaymentWebhookStatus @default(RECEIVED)
  occurredAt      DateTime
  receivedAt      DateTime             @default(now())
  appliedAt       DateTime?

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transaction  PaymentTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@unique([organizationId, providerKey, providerEventId])
  @@index([transactionId, status])
  @@map("payment_webhook_events")
}

model PaymentReconciliation {
  id            String   @id @default(cuid())
  transactionId String
  outcome       String
  reasonCode    String?
  providerRef   String?
  reconciledAt  DateTime @default(now())

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId, reconciledAt])
  @@map("payment_reconciliations")
}

model PaymentAdjustment {
  id            String                @id @default(cuid())
  transactionId String
  type          PaymentAdjustmentType
  amount        Decimal               @db.Decimal(12, 2)
  reason        String
  providerRef   String?
  createdAt     DateTime              @default(now())

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@map("payment_adjustments")
}

model PlatformInvoice {
  id             String        @id @default(cuid())
  organizationId String
  subscriptionId String
  invoiceNo      String        @unique
  amount         Decimal       @db.Decimal(12, 2)
  taxAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  status         InvoiceStatus @default(ISSUED)
  issuedAt       DateTime      @default(now())
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscription OrganizationSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)
  transaction  PaymentTransaction?

  @@index([organizationId, status])
  @@map("platform_invoices")
}

// ============================================
// إدارة المشاريع
// ============================================

model Project {
  id                String        @id @default(cuid())
  organizationId    String?
  title             String
  description       String?
  imageUrl          String?
  targetAmount      Float
  collectedAmount   Float         @default(0)
  completionPercent Float         @default(0)
  startDate         DateTime
  endDate           DateTime?
  status            ProjectStatus @default(PLANNING)
  category          String?
  location          String?
  creatorId         String?

  creator      User?         @relation("ProjectCreator", fields: [creatorId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  donations    Donation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("projects")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  SUSPENDED
  CANCELLED
}

// ============================================
// الأخبار
// ============================================

model News {
  id             String     @id @default(cuid())
  organizationId String?
  title          String
  slug           String     @unique
  content        String     @db.Text
  summary        String?
  imageUrl       String?
  category       String?
  status         NewsStatus @default(DRAFT)
  publishedAt    DateTime?
  authorId       String?

  author       User?         @relation("NewsAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("news")
}

enum NewsStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

// ============================================
// مكتبة الصور والفيديو
// ============================================

model PhotoAlbum {
  id          String  @id @default(cuid())
  title       String
  description String?
  coverUrl    String?
  sortOrder   Int     @default(0)

  photos Photo[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photo_albums")
}

model Photo {
  id           String  @id @default(cuid())
  albumId      String
  title        String?
  url          String
  thumbnailUrl String?
  sortOrder    Int     @default(0)

  album PhotoAlbum @relation(fields: [albumId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("photos")
}

model VideoCategory {
  id        String @id @default(cuid())
  name      String
  sortOrder Int    @default(0)

  videos Video[]

  @@map("video_categories")
}

model Video {
  id           String  @id @default(cuid())
  categoryId   String
  title        String
  description  String?
  url          String
  thumbnailUrl String?
  duration     String?
  sortOrder    Int     @default(0)

  category VideoCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("videos")
}

// ============================================
// الأنظمة والتعليمات
// ============================================

model ContentPage {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  content     String  @db.Text
  category    String
  sortOrder   Int     @default(0)
  isPublished Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("content_pages")
}

// ============================================
// الإعلانات
// ============================================

model Announcement {
  id         String    @id @default(cuid())
  title      String
  content    String?
  imageUrl   String?
  link       String?
  startDate  DateTime
  endDate    DateTime?
  isFeatured Boolean   @default(false)
  sortOrder  Int       @default(0)
  isActive   Boolean   @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("announcements")
}

// ============================================
// إدارة الفعاليات
// ============================================

model Event {
  id             String      @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  imageUrl       String?
  startDate      DateTime
  endDate        DateTime?
  location       String?
  capacity       Int?
  status         EventStatus @default(UPCOMING)

  attendees    EventAttendance[]
  organization Organization?     @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("events")
}

enum EventStatus {
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model EventAttendance {
  id            String           @id @default(cuid())
  eventId       String
  userId        String?
  beneficiaryId String?
  name          String?
  phone         String?
  status        AttendanceStatus @default(REGISTERED)

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([eventId])
  @@map("event_attendances")
}

enum AttendanceStatus {
  REGISTERED
  ATTENDED
  ABSENT
  CANCELLED
}

// ============================================
// إدارة المهام
// ============================================

model Task {
  id             String       @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  completedAt    DateTime?
  creatorId      String?
  assigneeId     String
  department     String?
  tags           String[]

  creator      User?         @relation("TaskCreator", fields: [creatorId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignee     User          @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: Cascade)

  comments    TaskComment[]
  attachments TaskAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assigneeId, status])
  @@index([status])
  @@index([organizationId])
  @@map("tasks")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  REVIEW
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskComment {
  id      String @id @default(cuid())
  taskId  String
  userId  String
  content String

  task        Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachments TaskAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("task_comments")
}

model TaskAttachment {
  id        String  @id @default(cuid())
  commentId String?
  taskId    String
  name      String
  url       String
  fileType  String
  size      Int

  comment TaskComment? @relation(fields: [commentId], references: [id], onDelete: SetNull)
  task    Task         @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_attachments")
}

// ============================================
// الاستبيانات
// ============================================

model Survey {
  id             String       @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  status         SurveyStatus @default(DRAFT)
  startDate      DateTime?
  endDate        DateTime?
  isPublic       Boolean      @default(false)

  questions    SurveyQuestion[]
  responses    SurveyResponse[]
  organization Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("surveys")
}

enum SurveyStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

model SurveyQuestion {
  id        String  @id @default(cuid())
  surveyId  String
  question  String
  type      String
  options   Json?
  sortOrder Int     @default(0)
  required  Boolean @default(false)

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  @@map("survey_questions")
}

model SurveyResponse {
  id              String  @id @default(cuid())
  surveyId        String
  respondentName  String?
  respondentPhone String?
  respondentId    String? // Can be userId, memberId, etc.
  respondentEmail String?

  survey  Survey         @relation(fields: [surveyId], references: [id], onDelete: Cascade)
  answers SurveyAnswer[]

  createdAt DateTime @default(now())

  @@map("survey_responses")
}

model SurveyAnswer {
  id            String  @id @default(cuid())
  responseId    String
  questionId    String
  answer        String?
  answerNumeric Float?

  response SurveyResponse @relation(fields: [responseId], references: [id], onDelete: Cascade)
  question SurveyQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("survey_answers")
}

// ============================================
// مؤشرات الأداء الرئيسية KPI
// ============================================

model KPI {
  id             String          @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  targetEntity   KPITargetEntity
  targetId       String?
  unit           String
  targetValue    Float
  strategicGoal  String?
  frequency      String          @default("monthly")
  status         KPIStatus       @default(ACTIVE)

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  records      KPIRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("kpis")
}

enum KPITargetEntity {
  DEPARTMENT
  PROJECT
  EMPLOYEE
}

enum KPIStatus {
  ACTIVE
  INACTIVE
  ACHIEVED
  BEHIND
}

model KPIRecord {
  id             String  @id @default(cuid())
  organizationId String?
  kpiId          String
  period         String
  actualValue    Float
  targetValue    Float
  percent        Float
  notes          String?

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  kpi          KPI           @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kpiId, period])
  @@index([organizationId])
  @@map("kpi_records")
}

// ============================================
// تقييمات الموظفين
// ============================================

model Evaluation {
  id          String           @id @default(cuid())
  employeeId  String
  evaluatorId String
  period      String
  startDate   DateTime
  endDate     DateTime?
  status      EvaluationStatus @default(DRAFT)
  finalScore  Float?
  notes       String?

  employee     User                   @relation("EvaluatedEmployee", fields: [employeeId], references: [id], onDelete: Cascade)
  evaluator    User                   @relation("Evaluator", fields: [evaluatorId], references: [id])
  goals        EvaluationGoal[]
  competencies EvaluationCompetency[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("evaluations")
}

enum EvaluationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  APPROVED
  REJECTED
}

model EvaluationGoal {
  id            String  @id @default(cuid())
  evaluationId  String
  title         String
  description   String?
  weight        Float
  score         Float?
  weightedScore Float?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("evaluation_goals")
}

model EvaluationCompetency {
  id            String  @id @default(cuid())
  evaluationId  String
  title         String
  description   String?
  weight        Float
  score         Float?
  weightedScore Float?

  evaluation Evaluation @relation(fields: [evaluationId], references: [id], onDelete: Cascade)

  @@map("evaluation_competencies")
}

// ============================================
// المتجر الإلكتروني
// ============================================

model StoreProduct {
  id          String  @id @default(cuid())
  name        String
  description String?
  price       Float
  stock       Int     @default(0)
  imageUrl    String?
  isDigital   Boolean @default(false)
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)

  orderItems OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_products")
}

model StoreOrder {
  id            String      @id @default(cuid())
  customerId    String?
  customerName  String?
  customerPhone String?
  customerEmail String?
  status        OrderStatus @default(PENDING)
  totalAmount   Float
  paymentRef    String?     @unique
  paidAt        DateTime?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("store_orders")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  quantity   Int
  unitPrice  Float
  totalPrice Float

  order   StoreOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product StoreProduct @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

// ============================================
// الشؤون المالية
// ============================================

model FinancialAccount {
  id               String  @id @default(cuid())
  organizationId   String
  name             String
  accountType      String
  accountCode      String?
  balance          Float   @default(0)
  isFundRestricted Boolean @default(false)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@map("financial_accounts")
}

model Transaction {
  id              String          @id @default(cuid())
  accountId       String
  amount          Float
  transactionType TransactionType
  description     String?
  referenceNo     String?
  transactionDate DateTime        @default(now())

  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

enum TransactionType {
  CREDIT
  DEBIT
}

model Budget {
  id             String        @id @default(cuid())
  organizationId String?
  title          String
  fiscalYear     String
  totalAmount    Float
  spentAmount    Float         @default(0)
  status         BudgetStatus  @default(DRAFT)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  items          BudgetItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("budgets")
}

enum BudgetStatus {
  DRAFT
  APPROVED
  ACTIVE
  CLOSED
}

model BudgetItem {
  id             String        @id @default(cuid())
  organizationId String?
  budgetId       String
  category       String
  description    String?
  allocated      Float
  spent          Float         @default(0)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  budget         Budget        @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  expenses       Expense[]     @relation("BudgetItemToExpense") // العلاقة المعاكس

  @@index([organizationId])
  @@map("budget_items")
}

model Expense {
  id             String        @id @default(cuid())
  organizationId String?
  title          String
  description    String?
  amount         Float
  category       String?
  status         ExpenseStatus @default(PENDING)
  expenseDate    DateTime      @default(now())
  approvedById   String?
  invoiceUrl     String?
  budgetItemId   String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  budgetItem     BudgetItem?   @relation("BudgetItemToExpense", fields: [budgetItemId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("expenses")
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

// ============================================
// التنبيهات والإشعارات
// ============================================

model Notification {
  id      String           @id @default(cuid())
  userId  String
  title   String
  content String?
  type    NotificationType @default(INFO)
  isRead  Boolean          @default(false)
  link    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
  DONATION
  TASK
  EVENT
  MEMBERSHIP
}

// ============================================
// رسائل SMS
// ============================================

model SMSTemplate {
  id       String  @id @default(cuid())
  name     String
  content  String
  category String
  isActive Boolean @default(true)

  @@map("sms_templates")
}

model SMSLog {
  id         String    @id @default(cuid())
  phone      String
  message    String
  templateId String?
  status     SMSStatus @default(SENT)
  provider   String?
  cost       Float?
  sentAt     DateTime  @default(now())

  @@index([phone])
  @@index([sentAt])
  @@map("sms_logs")
}

enum SMSStatus {
  PENDING
  SENT
  DELIVERED
  FAILED
}

// ============================================
// إعدادات النظام
// ============================================

model SiteSetting {
  id             String @id @default(cuid())
  organizationId String
  key            String
  value          String
  type           String @default("string")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@map("site_settings")
}

// ============================================
// W01 — حالة تهيئة النسخة (لا تتضمن ترخيصاً أو بيانات تشغيلية)
// ============================================

// W02 — Vault, privacy, activation and IdP contracts.
// No provider credential, plaintext secret, private key or tenant authority is stored here.
model SecretRecord {
  id              String             @id @default(cuid())
  organizationId  String
  providerKey     String
  purpose         String
  opaqueReference String
  keyVersion      String
  status          SecretRecordStatus @default(ACTIVE)
  rotatedFromId   String?
  createdById     String
  revokedAt       DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, providerKey, purpose, keyVersion])
  @@index([organizationId, providerKey, purpose, status])
  @@map("secret_records")
}

model SecretAccessAudit {
  id             String   @id @default(cuid())
  organizationId String
  secretRecordId String
  actorId        String
  action         String
  purpose        String
  outcome        String
  correlationId  String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, secretRecordId, createdAt])
  @@index([correlationId])
  @@map("secret_access_audits")
}

model PrivacyPolicyBinding {
  id              String             @id @default(cuid())
  organizationId  String
  recordType      String
  classification  DataClassification
  policyReference String?
  isApproved      Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, recordType])
  @@index([organizationId, classification, isApproved])
  @@map("privacy_policy_bindings")
}

model PrivacyRequest {
  id             String               @id @default(cuid())
  organizationId String
  requesterId    String
  type           PrivacyRequestType
  recordType     String
  classification DataClassification
  purposeCode    String
  status         PrivacyRequestStatus @default(POLICY_REQUIRED)
  legalHold      Boolean              @default(false)
  decisionReason String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  completedAt    DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, createdAt])
  @@index([organizationId, requesterId, createdAt])
  @@map("privacy_requests")
}

model ActivationRecord {
  id                     String           @id @default(cuid())
  organizationId         String
  licenseKeyId           String
  instanceId             String
  certificateFingerprint String
  activationCodeHash     String
  activationCodeSalt     String
  status                 ActivationStatus @default(PENDING)
  attemptCount           Int              @default(0)
  expiresAt              DateTime
  consumedAt             DateTime?
  revokedAt              DateTime?
  createdById            String
  correlationId          String
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, licenseKeyId, instanceId])
  @@index([organizationId, status, expiresAt])
  @@map("activation_records")
}

model IdentityProviderConfig {
  id                String                      @id @default(cuid())
  organizationId    String
  providerKey       String
  environment       IdentityProviderEnvironment
  clientSecretRefId String?
  issuerUri         String?
  subjectClaim      String                      @default("sub")
  status            IdentityProviderStatus      @default(DISABLED)
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  organization    Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subjectBindings IdentitySubjectBinding[]
  callbackStates  IdentityProviderCallbackState[]

  @@unique([organizationId, providerKey, environment])
  @@index([organizationId, status])
  @@map("identity_provider_configs")
}

model IdentitySubjectBinding {
  id                       String    @id @default(cuid())
  organizationId           String
  identityProviderConfigId String
  membershipId             String
  subjectHash              String
  isActive                 Boolean   @default(true)
  revokedAt                DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig IdentityProviderConfig @relation(fields: [identityProviderConfigId], references: [id], onDelete: Cascade)

  @@unique([identityProviderConfigId, subjectHash])
  @@unique([identityProviderConfigId, membershipId])
  @@index([organizationId, membershipId, isActive])
  @@map("identity_subject_bindings")
}

model IdentityProviderCallbackState {
  id                       String    @id @default(cuid())
  organizationId           String
  identityProviderConfigId String
  membershipId             String
  stateHash                String    @unique
  expiresAt                DateTime
  consumedAt               DateTime?
  createdAt                DateTime  @default(now())

  organization   Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConfig IdentityProviderConfig @relation(fields: [identityProviderConfigId], references: [id], onDelete: Cascade)

  @@index([organizationId, expiresAt])
  @@index([identityProviderConfigId, expiresAt])
  @@map("identity_provider_callback_states")
}

enum InstallationStateStatus {
  UNCONFIGURED
  PREFLIGHT_PASSED
  COMPLETED
  RECOVERY_UNLOCKED
}

model InstallationState {
  id                      String                  @id @default("singleton")
  status                  InstallationStateStatus @default(UNCONFIGURED)
  releaseVersion          String?
  lastPreflightAt         DateTime?
  completedAt             DateTime?
  recoveryUnlockExpiresAt DateTime?
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@map("installation_state")
}

model InstanceIdentity {
  id           String   @id @default("singleton")
  instanceId   String   @unique
  keyVersion   String   @default("v1")
  integrityTag String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("instance_identity")
}

model MenuItem {
  id        String  @id @default(cuid())
  title     String
  url       String?
  icon      String?
  parentId  String?
  sortOrder Int     @default(0)
  isOpen    Boolean @default(true)
  isVisible Boolean @default(true)
  target    String?

  children MenuItem[] @relation("MenuItemHierarchy")
  parent   MenuItem?  @relation("MenuItemHierarchy", fields: [parentId], references: [id], onDelete: Cascade)

  @@map("menu_items")
}

// ============================================
// سجل التدقيق
// ============================================

model AuditLog {
  id             String  @id @default(cuid())
  userId         String?
  organizationId String?
  action         String
  entity         String
  entityId       String?
  details        Json?
  ipAddress      String?

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([organizationId, createdAt])
  @@map("audit_logs")
}

// ============================================
// طلبات تجربة النظام
// ============================================

model TrialRequest {
  id      String      @id @default(cuid())
  name    String
  email   String
  phone   String
  orgName String?
  message String?
  status  TrialStatus @default(PENDING)

  @@map("trial_requests")
}

enum TrialStatus {
  PENDING
  APPROVED
  REJECTED
  EXPIRED
}

// ============================================
// مشاركة التقارير
// ============================================

model ReportShare {
  id         String    @id @default(cuid())
  title      String
  reportType String
  data       Json
  sharedById String
  sharedWith String[]
  expiresAt  DateTime?

  @@map("report_shares")
}

// ============================================
// المستندات العامة
// ============================================

model Document {
  id             String  @id @default(cuid())
  organizationId String?
  name           String
  fileUrl        String
  fileType       String
  size           Int
  category       String?
  relatedEntity  String? // e.g., "User", "Project"
  relatedId      String?
  uploadedById   String?

  organization    Organization?    @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  privateArtifact PrivateArtifact?

  @@index([organizationId])
  @@map("documents")
}

model PrivateArtifact {
  id             String   @id
  organizationId String
  documentId     String   @unique
  objectKey      String   @unique
  version        Int      @default(1)
  contentType    String
  size           Int
  state          String   @default("ACTIVE")
  uploadedById   String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([organizationId, state])
  @@map("private_artifacts")
}
